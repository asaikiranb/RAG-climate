# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# ChromaDB Collection Name (local storage, no cloud credentials needed)
CHROMA_COLLECTION_NAME=saikiran_corpus

# Whisper model size for voice input feature.
# Use 'medium' locally (best quality for Indian languages, needs ~1.2GB RAM).
# Use 'small' on Streamlit Community Cloud free tier (fits within 1GB RAM limit).
WHISPER_MODEL=medium

# ── WhatsApp Integration ────────────────────────────────────────────────────
# Get these from https://developers.facebook.com → your App → WhatsApp → API Setup

# Permanent access token from Meta Developer Console
WHATSAPP_TOKEN=your_whatsapp_token_here

# Meta-assigned Phone Number ID (not the actual phone number)
PHONE_NUMBER_ID=your_phone_number_id_here

# Any string you choose — must match what you enter in Meta webhook settings
VERIFY_TOKEN=your_verify_token_here
